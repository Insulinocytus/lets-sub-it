# Docker 端口绑定主机（默认仅本机访问；如需局域网访问可改为 0.0.0.0）
LSI_DOCKER_BIND_HOST=127.0.0.1

# 容器内后端运行设置（通常无需修改）
LSI_ADDR=0.0.0.0:8080
LSI_DB_PATH=/data/backend.sqlite3
LSI_WORK_DIR=/data/jobs
LSI_LOG_LEVEL=info

# LLM 配置（翻译链路必填 API_KEY 和 MODEL）
LSI_LLM_BASE_URL=https://api.openai.com
LSI_LLM_API_KEY=sk-your-key-here
LSI_LLM_MODEL=gpt-4.1-mini
LSI_LLM_TIMEOUT=2m

# 本地转写（STT）：Compose 内置的 docker-whisper 服务
# 必填：本地 whisper 容器与后端共用的密钥，请改成自己的随机值
LSI_LOCAL_STT_API_KEY=change-me-local-stt-key
# 本地容器的模型与计算类型（首次启动下载模型到持久卷）
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# 后端转写地址与密钥：留空即使用 Compose 内的 whisper 服务，
# 密钥回退到上面的 LSI_LOCAL_STT_API_KEY。
# 使用外部 OpenAI 兼容服务时，把下面两项改成外部地址和非空的密钥，
# 并设置 LSI_STT_MODEL（如 whisper-1）。这些值只注入后端容器，
# 不会传给本地 whisper 容器（本地容器只接收 WHISPER_MODEL、WHISPER_COMPUTE_TYPE 与 LSI_LOCAL_STT_API_KEY）。
LSI_STT_BASE_URL=
LSI_STT_API_KEY=
# LSI_STT_MODEL=whisper-1
LSI_STT_TIMEOUT=30m

# 下载超时
LSI_DOWNLOAD_TIMEOUT=10m
